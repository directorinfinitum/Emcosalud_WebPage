---
import Icon from '@/components/icons/Icon.astro';

interface Props {
  year: string;
  portalId?: number; // 👈 1. Añadido a las props
}

const { year, portalId } = Astro.props;

interface CarteleraItem {
  id: number;
  title: string; // Aquí viene el mes seleccionado (ej. 'ENERO', 'FEBRERO'...)
  description?: string;
  publishedDate?: string;
  imageUrl?: string;
}

// Diccionario para ordenar los meses cronológicamente
const MONTH_ORDER: Record<string, number> = {
  ENERO: 1,
  FEBRERO: 2,
  MARZO: 3,
  ABRIL: 4,
  MAYO: 5,
  JUNIO: 6,
  JULIO: 7,
  AGOSTO: 8,
  SEPTIEMBRE: 9,
  OCTUBRE: 10,
  NOVIEMBRE: 11,
  DICIEMBRE: 12,
};

let issues: { label: string; href: string }[] = [];

try {
  // 👈 2. Construimos la URL de forma dinámica agregando portalId si está presente
  const url = new URL('http://localhost:4321/api/publicaciones.json');
  if (portalId) {
    url.searchParams.set('portalId', String(portalId));
  }

  const response = await fetch(url.toString());

  if (response.ok) {
    const json = await response.json();
    const publications: CarteleraItem[] = json.data ?? [];

    // 1. Filtramos por año basándonos en publishedDate
    const filtered = publications.filter((pub) => {
      if (!pub.publishedDate) return false;
      const pubYear = new Date(pub.publishedDate).getFullYear().toString();
      return pubYear === String(year).trim();
    });

    // 2. Ordenamos por mes utilizando el diccionario MONTH_ORDER
    filtered.sort((a, b) => {
      const mesA = a.title?.trim().toUpperCase() || '';
      const mesB = b.title?.trim().toUpperCase() || '';
      return (MONTH_ORDER[mesA] || 99) - (MONTH_ORDER[mesB] || 99);
    });

    // 3. Mapeamos a la estructura de la UI (capitalizando la primera letra para que se vea bien)
    issues = filtered.map((pub) => {
      const rawTitle = pub.title || 'Cartelera';
      const formattedLabel = rawTitle.charAt(0).toUpperCase() + rawTitle.slice(1).toLowerCase();

      return {
        label: formattedLabel,
        href: pub.imageUrl || '#',
      };
    });
  }
} catch (error) {
  console.error(`Error al obtener las carteleras del año ${year}:`, error);
  issues = [];
}
---

<section class="section-block">
  <div class="container-page max-w-3xl">
    <h2 class="m-0 text-xl font-bold text-brand-blue">Carteleras {year}</h2>
    {issues.length ? (
      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {issues.map((issue) => (
          <li>
            <a
              href={issue.href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-brand-blue no-underline shadow-sm transition hover:border-brand-green/40 hover:bg-brand-green/5"
            >
              {issue.label}
              <Icon name="external" size={16} class="shrink-0 opacity-60" />
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-4 text-slate-600">Próximamente se publicarán las carteleras de este año.</p>
    )}
  </div>
</section>

<script>
  window.dispatchEvent(new Event('cartelera-loaded'));
</script>