---
import "src/styles/youtube.css"

const CHANNEL_ID = "UCw0u0QY1yUDUr0YNtq10_Yw";

const response = await fetch(
  `https://www.youtube.com/feeds/videos.xml?channel_id=${CHANNEL_ID}`
);

const xmlText = await response.text();

const entries = [...xmlText.matchAll(/<entry>([\s\S]*?)<\/entry>/g)];

const videos = entries.slice(0, 7).map((entry) => {
  const content = entry[1];

  const title =
    content.match(/<title>(.*?)<\/title>/)?.[1] || "Sin título";

  const videoId =
    content.match(/<yt:videoId>(.*?)<\/yt:videoId>/)?.[1] || "";

  const published =
    content.match(/<published>(.*?)<\/published>/)?.[1] || "";

  return {
    title,
    videoId,
    published,
    thumbnail: `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`,
  };
});


const recentVideos = videos.slice(0, 6);
---

<section class="youtube-section">
  <div class="container">

    <div class="section-header">
      <h2 class="section-title">EMCOSALUD</h2>
      <p >Conoce nuestras entrevistas, eventos, campañas y contenidos institucionales.</p>
    </div>

    <div class="videos-grid">
      {recentVideos.map((video) => (
        <a
          href={`https://www.youtube.com/watch?v=${video.videoId}`}
          target="_blank"
          rel="noopener noreferrer"
          class="video-card"
        >
          <img
            src={video.thumbnail}
            alt={video.title}
            loading="lazy"
          />

          <div class="video-content">
            <h3 >{video.title}</h3>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

