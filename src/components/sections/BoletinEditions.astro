---
import Icon from '@/components/icons/Icon.astro';

interface Props {
  year: string;
  categorySlug?: string;
  categoryId?: number;
  portalId?: number; // 👈 1. Añadido a las props
}

const { year, categorySlug, portalId } = Astro.props;

// Estructura ligera que esperas recibir de la API del CMS
interface BoletinItem {
  id: number;
  title: string;
  description?: string;
  publishedDate?: string;
  pdfUrl?: string;
  coverUrl?: string;
}

const MONTH_ORDER: Record<string, number> = {
  ENERO: 1, FEBRERO: 2, MARZO: 3, ABRIL: 4,
  MAYO: 5, JUNIO: 6, JULIO: 7, AGOSTO: 8,
  SEPTIEMBRE: 9, OCTUBRE: 10, NOVIEMBRE: 11, DICIEMBRE: 12,
};

let boletines: BoletinItem[] = [];

try {
  // 👈 2. Construimos la URL de forma dinámica agregando portalId si viene definido
  const url = new URL('http://localhost:4321/api/boletines.json');
  if (portalId) {
    url.searchParams.set('portalId', String(portalId));
  }
  if (categorySlug) {
    url.searchParams.set('category', categorySlug);
  }

  const response = await fetch(url.toString());
  if (response.ok) {
    const json = await response.json();
    boletines = json.data ?? [];
  }
} catch (error) {
  console.error('Error al conectar con la API del CMS:', error);
  boletines = [];
}

// Filtramos y transformamos para la vista
const issues = boletines
  .filter((b) => {
    if (!b.publishedDate) return false;
    const postYear = new Date(b.publishedDate).getFullYear().toString();
    return postYear === String(year).trim();
  })
  .map((b) => {
    const rawMes = b.title ? b.title.trim().toUpperCase() : '';
    const monthIndex = MONTH_ORDER[rawMes] ?? 99;

    return {
      label: b.title || 'Edición',
      href: b.pdfUrl ?? '#',
      monthIndex,
    };
  })
  .sort((a, b) => a.monthIndex - b.monthIndex);
---

<section class="section-block">
  <div class="container-page max-w-3xl">
    <h2 class="m-0 text-xl font-bold text-brand-blue">Ediciones {year}</h2>
    
    {issues.length > 0 ? (
      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {issues.map((issue) => (
          <li>
            <a
              href={issue.href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-brand-blue no-underline shadow-sm transition hover:border-brand-green/40 hover:bg-brand-green/5"
            >
              {issue.label}
              <Icon name="external" size={16} class="shrink-0 opacity-60" />
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-4 text-slate-600">Próximamente se publicarán las ediciones de este año.</p>
    )}
  </div>
</section>

<script>
  // Oculta el spinner de carga de la página del usuario cuando se renderiza este componente
  window.dispatchEvent(new CustomEvent('cartelera-loaded'));
</script>