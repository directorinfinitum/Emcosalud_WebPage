---
import BaseLayout from '@/layouts/BaseLayout.astro';

export const prerender = false;

const { slug } = Astro.params;

// 1. OBTENER EL SLUG DEL PORTAL ACTUAL
const portalSlug = 
  Astro.request.headers.get('x-portal-slug') || 
  Astro.url.searchParams.get('portal') || 
  'emcosalud';
interface PostView {
  id: string;
  title: string;
  contentHtml: string;
  excerpt?: string | null;
  publishedAt?: string | null;
  createdAt: string;
  imageUrl: string;
  authorName?: string | null;
  categoryName?: string | null;
}

let post: PostView | null = null;

try {
  // 2. PASAR EL PORTAL AL ENDPOINT DEL CMS
  const response = await fetch(`http://localhost:4321/api/blog/${slug}?portal=${portalSlug}`);

  if (response.ok) {
    const json = await response.json();
    const data = json.data;

    if (data) {
      post = {
        id: data.id,
        title: data.title,
        contentHtml: data.contentHtml || '',
        excerpt: data.excerpt,
        publishedAt: data.publishedAt,
        createdAt: data.createdAt,
        imageUrl: data.featuredUrl || '',
        authorName: data.authorName,
        categoryName: data.categoryName,
      };
    }
  }
} catch (error) {
  console.error('Error al conectar con el CMS para el detalle del blog:', error);
}

if (!post) {
  return Astro.redirect('/404');
}

function formatDate(iso: string) {
  if (!iso) return '';
  return new Date(iso).toLocaleDateString('es-CO', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}
---

<BaseLayout title={post.title}>
  <article class="section-block py-10 sm:py-16">
    <div class="container-page max-w-4xl">
      <p class="mb-6">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 font-semibold text-brand-blue no-underline transition hover:text-brand-green-dark"
        >
          <span aria-hidden="true">&larr;</span>
          Volver al blog
        </a>
      </p>

      <header class="mb-8">
        <div class="mb-3 flex items-center gap-3 text-sm font-bold text-slate-500">
          {post.categoryName && (
            <span class="rounded-full bg-brand-green-dark/10 px-3 py-1 text-xs text-brand-green-dark">
              {post.categoryName}
            </span>
          )}
          <time datetime={post.publishedAt || post.createdAt}>
            {formatDate(post.publishedAt || post.createdAt)}
          </time>
        </div>

        <h1 class="section-title text-3xl font-extrabold leading-tight text-brand-blue sm:text-4xl">
          <Fragment set:html={post.title} />
        </h1>
      </header>

      {post.imageUrl && (
        <div class="mb-10 overflow-hidden rounded-2xl bg-slate-100 shadow-sm aspect-video flex items-center justify-center">
          <img
            src={post.imageUrl}
            alt={post.title}
            class="h-full w-full object-contain"
          />
        </div>
      )}

      <div class="prose prose-slate max-w-none text-slate-700 prose-headings:text-brand-blue prose-a:text-brand-green-dark hover:prose-a:underline prose-img:rounded-xl prose-img:shadow-sm">
        <Fragment set:html={post.contentHtml} />
      </div>
    </div>
  </article>
</BaseLayout>