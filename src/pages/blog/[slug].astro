---
import BaseLayout from '@/layouts/BaseLayout.astro';

// Desactivar el prerenderizado estático solo para esta página si usas SSG predeterminado
export const prerender = false;

const { slug } = Astro.params;

interface Post {
  id: number;
  rawTitle: string;
  pageTitle: string;
  content: string;
  excerpt: string;
  date: string;
  imageUrl: string;
}

function cleanTitleText(rawTitle: string): string {
  if (!rawTitle) return '';
  return rawTitle
    .replace(/&#8211;/g, '–')
    .replace(/&#8217;/g, "'")
    .replace(/&#8220;/g, '"')
    .replace(/&#8221;/g, '"')
    .replace(/&amp;/g, '&')
    .replace(/<[^>]+>/g, '')
    .trim();
}

let post: Post | null = null;

try {
  // Consultar la entrada directamente por su SLUG
  const response = await fetch(
    `https://emcosalud.com.co/wp-json/wp/v2/posts?slug=${slug}&_embed`
  );

  if (response.ok) {
    const rawPosts = await response.json();

    if (rawPosts && rawPosts.length > 0) {
      const p = rawPosts[0];

      let imageUrl = p._embedded?.['wp:featuredmedia']?.[0]?.source_url || '';

      if (!imageUrl && p.content?.rendered) {
        const match = p.content.rendered.match(/<img[^>]+src=["']([^"']+)["']/i);
        if (match) imageUrl = match[1];
      }

      if (!imageUrl) {
        imageUrl = 'https://emcosalud.com.co/wp-content/uploads/2025/01/logo-emcosalud.png';
      }

      const cleanExcerpt = p.excerpt?.rendered
        ? p.excerpt.rendered.replace(/<[^>]+>/g, '').trim()
        : '';

      const rawTitle = p.title?.rendered || '';

      post = {
        id: p.id,
        rawTitle,
        pageTitle: cleanTitleText(rawTitle),
        content: p.content?.rendered || '',
        excerpt: cleanExcerpt,
        date: p.date,
        imageUrl,
      };
    }
  }
} catch (error) {
  console.error('Error al obtener la entrada del blog:', error);
}

// Redirigir a 404 si la publicación no fue encontrada en WordPress
if (!post) {
  return Astro.redirect('/404');
}

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('es-CO', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}
---

<BaseLayout title={post.pageTitle}>
  <article class="section-block py-10 sm:py-16">
    <div class="container-page max-w-4xl">
      <!-- Botón de regreso -->
      <p class="mb-6">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 font-semibold text-brand-blue no-underline transition hover:text-brand-green-dark"
        >
          <span aria-hidden="true">&larr;</span>
          Volver al blog
        </a>
      </p>

      <!-- Encabezado de la publicación -->
      <header class="mb-8">
        <time class="mb-3 block text-sm font-bold text-brand-green-dark" datetime={post.date}>
          {formatDate(post.date)}
        </time>
        <h1 class="section-title text-3xl font-extrabold leading-tight text-brand-blue sm:text-4xl">
          <Fragment set:html={post.rawTitle} />
        </h1>
        
      </header>

      <!-- Imagen Principal -->
      {post.imageUrl && (
        <div class="mb-10 overflow-hidden rounded-2xl bg-slate-100 shadow-sm">
          <img
            src={post.imageUrl}
            alt={post.pageTitle}
            class="max-h-full w-full object-cover"
          />
        </div>
      )}

      <!-- Contenido HTML renderizado desde WordPress -->
      <div class="prose prose-slate max-w-none text-slate-700 prose-headings:text-brand-blue prose-a:text-brand-green-dark hover:prose-a:underline prose-img:rounded-xl prose-img:shadow-sm">
        <Fragment set:html={post.content} />
      </div>
    </div>
  </article>
</BaseLayout>