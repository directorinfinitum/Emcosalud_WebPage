---
// src/pages/capacitaciones/[year].astro
import AtencionUsuarioHero from '@/components/sections/AtencionUsuarioHero.astro';
import CapacitacionesEditions from '@/components/sections/CapacitacionesEditions.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const EMCOSALUD_PORTAL_ID = 1;

// 1. Obtenemos dinámicamente los años desde el CMS al compilar
export async function getStaticPaths() {
  // Años históricos base por seguridad para evitar que desaparezcan si la API limita registros o falla
  const defaultYears = ['2027', '2026'];
  const yearsSet = new Set<string>(defaultYears);

  try {
    // Añadimos un parámetro de límite alto (ej: limit=1000) por si el endpoint pagina los resultados
    const response = await fetch(`http://localhost:4321/api/capacitaciones.json?portalId=2&limit=1000`);
    if (response.ok) {
      const json = await response.json();
      const publications = json.data ?? [];

      publications.forEach((pub: { publishedDate?: string }) => {
        if (pub.publishedDate) {
          // Extraemos los primeros 4 caracteres de forma segura para evitar desfases por zonas horarias
          const pubYear = pub.publishedDate.toString().substring(0, 4);
          if (/^\d{4}$/.test(pubYear)) {
            yearsSet.add(pubYear);
          }
        }
      });
    }
  } catch (error) {
    console.error('Error al obtener los años desde la API, usando años por defecto:', error);
  }

  // Convertimos el Set en el formato que Astro exige para getStaticPaths
  return Array.from(yearsSet).map((year) => ({
    params: { year },
  }));
}

// 2. Extraemos el año actual de la URL
const { year } = Astro.params;
---

<BaseLayout title={`Capacitaciones ${year}`} description={`Capacitaciones y programas educativos ${year} — EMCOSALUD.`}>
  <!-- Overlay del Spinner -->
  <div 
    id="page-loading-overlay" 
    class="fixed inset-0 z-[9999] flex flex-col items-center justify-center bg-white/90 backdrop-blur-sm transition-opacity duration-300"
  >
    <div class="flex flex-col items-center gap-3">
      <svg class="h-10 w-10 animate-spin text-brand-blue" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span class="text-sm font-semibold text-brand-blue">Cargando Capacitaciones {year}...</span>
    </div>
  </div>

  <AtencionUsuarioHero title={`Capacitaciones ${year}`} lead="Consulta y descarga el cronograma y material de capacitaciones." />
  
  {/* Tu componente hijo se encarga de hacer el fetch filtrado por este año */}
  <CapacitacionesEditions year={year} />
</BaseLayout>

<script is:inline>
  const overlay = document.getElementById('page-loading-overlay');

  function hideSpinner() {
    if (overlay) {
      overlay.classList.add('opacity-0', 'pointer-events-none');
      setTimeout(() => {
        overlay.style.display = 'none';
      }, 300);
    }
  }

  function showSpinner() {
    if (overlay) {
      overlay.style.display = 'flex';
      overlay.classList.remove('opacity-0', 'pointer-events-none');
    }
  }

  window.addEventListener('capacitaciones-loaded', hideSpinner);
  const fallbackTimer = setTimeout(hideSpinner, 4000);

  if (document.readyState === 'complete') {
    setTimeout(hideSpinner, 500);
  } else {
    window.addEventListener('load', () => {
      setTimeout(hideSpinner, 500);
    });
  }

  document.addEventListener('click', (e) => {
    const link = e.target.closest('a');
    if (link) {
      const href = link.getAttribute('href');
      const target = link.getAttribute('target');
      if (href && !href.startsWith('#') && target !== '_blank') {
        showSpinner();
      }
    }
  });
</script>