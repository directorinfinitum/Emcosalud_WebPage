---
import Icon from '@/components/icons/Icon.astro';
import PqrsfForm from '@/components/react/PqrsfForm';

import BaseLayout from '@/layouts/BaseLayout.astro';


---

<BaseLayout
  title="PQRSF"
  description="Te invitamos a diligenciar nuestro formulario de PQRSF"
>
  <section class="bg-brand-blue-dark py-12 text-white md:py-14">
    <div class="container-page">
      <p class="mb-2 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-brand-green-light">
        <Icon name="shield-check" size={18} />
        Institucional
      </p>
      <h1 class="m-0 text-3xl font-bold md:text-4xl">PQRSF</h1>
      <p class="mt-3 max-w-3xl text-lg text-white/90">En EMCOSALUD trabajamos cada día para brindarte una mejor atención. Te invitamos a diligenciar nuestro formulario de PQRSF (Peticiones, Quejas, Reclamos, Sugerencias y Felicitaciones) para conocer tus comentarios, inquietudes o reconocimientos sobre nuestros servicios. Tu participación nos ayuda a mejorar continuamente y a ofrecer una atención más humana, eficiente y de calidad. 📝 Completa el formulario y comparte tu experiencia con nosotros. ¡Gracias por contribuir al mejoramiento de nuestros servicios! 💙🏥</p>
      
    </div>
  </section>


    <br>

    <aside class="mx-auto w-full max-w-2xl">
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-brand md:p-6">
        <div class="mb-5 border-b border-slate-100 pb-4">
          <p class="mb-1 text-xs font-semibold uppercase tracking-wide text-brand-green-dark">
            Formulario en línea
          </p>

          <h2 class="m-0 text-xl font-bold text-brand-blue">
            Formulario de PQRSF
          </h2>

          <p class="mt-2 m-0 text-sm leading-relaxed text-slate-600">
            Completa tus datos y adjunta los documentos requeridos.
          </p>
        </div>

        <PqrsfForm client:load />
      </div>
    </aside>

    <br>
    <br>
  </section>


</BaseLayout>


    

