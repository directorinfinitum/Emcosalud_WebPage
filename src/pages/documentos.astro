---
import BaseLayout from '@/layouts/BaseLayout.astro';

// ID numérico de la Entidad "Emcosalud" en WordPress
const ID_ENTIDAD_EMCOSALUD = 5; 
---

<BaseLayout title="Consulta de documentos - Emcosalud">
  <section class="max-w-2xl mx-auto px-4 py-12">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Consulta de Documentos</h1>
      <p class="text-gray-600">Ingresa tu número de cédula o NIT para descargar tu certificado.</p>
    </div>

    <!-- Formulario de Búsqueda -->
    <form id="form-busqueda" class="flex flex-col sm:flex-row gap-3 mb-8">
      <input
        type="text"
        inputmode="numeric"
        id="documento"
        name="documento"
        placeholder="Ej. 93390866"
        required
        class="flex-1 px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none"
      />
      <button
        type="submit"
        id="btn-buscar"
        class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors flex items-center justify-center min-w-[120px]"
      >
        <span id="btn-text">Buscar</span>
      </button>
    </form>

    <!-- Estado de carga -->
    <div id="loading" class="hidden text-center py-4 text-gray-500 font-medium">
      <div class="inline-block animate-spin rounded-full h-6 w-6 border-b-2 border-blue-600 mr-2 align-middle"></div>
      Buscando certificados...
    </div>

    <!-- Contenedor de Resultados -->
    <div id="resultados" class="space-y-4"></div>
  </section>
</BaseLayout>

<script define:vars={{ ID_ENTIDAD_EMCOSALUD }}>
  const form = document.getElementById('form-busqueda');
  const inputDocumento = document.getElementById('documento');
  const resultadosDiv = document.getElementById('resultados');
  const loadingDiv = document.getElementById('loading');
  const btnBuscar = document.getElementById('btn-buscar');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const documento = inputDocumento.value.trim();

    if (!documento) return;

    // Limpiar interfaz y bloquear botón durante el proceso
    resultadosDiv.innerHTML = '';
    loadingDiv?.classList.remove('hidden');
    if (btnBuscar) btnBuscar.disabled = true;

    try {
      const BASE_URL = 'https://gestion.emcosalud.com.co';
      
      // Agregado per_page=100 para evitar que la API limite los resultados a 10 por defecto
      const WP_API = `${BASE_URL}/wp-json/wp/v2/documentos?search=${encodeURIComponent(documento)}&entidades=${ID_ENTIDAD_EMCOSALUD}&per_page=100&_embed`;
      
      const response = await fetch(WP_API);

      if (!response.ok) {
        throw new Error(`Error HTTP ${response.status}: ${response.statusText}`);
      }

      const registros = await response.json();

      // Validación con regex exacta para evitar coincidencias parciales
      const exactRegex = new RegExp(`(?:^|[^0-9])${documento}(?:[^0-9]|$)`);

      const certificadosEncontrados = registros.filter((item) => {
        const titulo = item.title?.rendered || '';
        const urlMeta = item.meta?._documento_url || '';
        const slug = item.slug || '';

        return exactRegex.test(titulo) || exactRegex.test(urlMeta) || exactRegex.test(slug);
      });

      if (certificadosEncontrados.length === 0) {
        resultadosDiv.innerHTML = `
          <div class="p-4 text-amber-800 bg-amber-50 rounded-lg border border-amber-200 text-center">
            No se encontraron certificados asociados exactamente al documento <strong>${documento}</strong> en Emcosalud.
          </div>
        `;
        return;
      }

      resultadosDiv.innerHTML = certificadosEncontrados
        .map((cert) => {
          const titulo = cert.title?.rendered || 'Certificado PDF';
          
          // Estrategia de extracción de URL
          let pdfUrl = cert.meta?._documento_url;

          if (!pdfUrl && cert._embedded?.['wp:attachment']?.[0]) {
            pdfUrl = cert._embedded['wp:attachment'][0].source_url;
          }

          if (!pdfUrl && cert._embedded?.['wp:featuredmedia']?.[0]) {
            pdfUrl = cert._embedded['wp:featuredmedia'][0].source_url;
          }

          if (!pdfUrl) {
            pdfUrl = `${BASE_URL}/wp-content/uploads/${cert.slug}.pdf`;
          }

          return `
            <div class="p-5 border border-gray-200 rounded-lg shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white hover:border-gray-300 transition-colors">
              <div>
                <h3 class="font-semibold text-gray-800 uppercase text-sm">${titulo}</h3>
                <span class="text-xs text-gray-500">Documento: ${documento}</span>
              </div>
              <a 
                href="${pdfUrl}" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-md transition-colors flex items-center gap-2 self-end sm:self-auto"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                  <path d="M13 8V2H7v6H2l8 8 8-8h-5zM0 18h20v2H0v-2z"/>
                </svg>
                Descargar PDF
              </a>
            </div>
          `;
        })
        .join('');

    } catch (error) {
      console.error('Error detallado en la consulta:', error);
      resultadosDiv.innerHTML = `
        <div class="p-4 text-red-800 bg-red-50 rounded-lg border border-red-200 text-center">
          Ocurrió un error al procesar la búsqueda. Por favor intenta de nuevo más tarde.
        </div>
      `;
    } finally {
      loadingDiv?.classList.add('hidden');
      if (btnBuscar) btnBuscar.disabled = false;
    }
  });
</script>