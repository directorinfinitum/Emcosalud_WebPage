---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Consulta de documentos - Sociedad Clínica Emcosalud">
  <section class="max-w-2xl mx-auto px-4 py-12">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Consulta de Documentos</h1>
      <p class="text-gray-600">Ingresa tu número de cédula o NIT para descargar tu certificado.</p>
    </div>

    <!-- Formulario de Búsqueda -->
    <form id="form-busqueda" class="flex flex-col sm:flex-row gap-3 mb-8">
      <input
        type="text"
        inputmode="numeric"
        id="documento"
        name="documento"
        placeholder="Ej. 93390866"
        required
        class="flex-1 px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none"
      />
      <button
        type="submit"
        id="btn-buscar"
        class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors flex items-center justify-center min-w-[120px]"
      >
        <span id="btn-text">Buscar</span>
      </button>
    </form>

    <!-- Estado de carga -->
    <div id="loading" class="hidden text-center py-4 text-gray-500 font-medium">
      <div class="inline-block animate-spin rounded-full h-6 w-6 border-b-2 border-blue-600 mr-2 align-middle"></div>
      Buscando certificados...
    </div>

    <!-- Contenedor de Resultados -->
    <div id="resultados" class="space-y-4"></div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('form-busqueda');
  const inputDocumento = document.getElementById('documento') as HTMLInputElement;
  const resultadosDiv = document.getElementById('resultados');
  const loadingDiv = document.getElementById('loading');
  const btnBuscar = document.getElementById('btn-buscar') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const documento = inputDocumento.value.trim();

    if (!documento) return;

    // Limpiar interfaz y bloquear botón durante el proceso
    if (resultadosDiv) resultadosDiv.innerHTML = '';
    loadingDiv?.classList.remove('hidden');
    if (btnBuscar) btnBuscar.disabled = true;

    try {
      // URL de tu CMS local corriendo en desarrollo (ajusta el puerto si es necesario, ej. 4321)
      const CMS_API = `http://localhost:4321/api/search.json?doc=${encodeURIComponent(documento)}`;
      
      const response = await fetch(CMS_API);

      if (!response.ok) {
        throw new Error(`Error HTTP ${response.status}: ${response.statusText}`);
      }

      const certificadosEncontrados = await response.json();

      if (!resultadosDiv) return;

      if (certificadosEncontrados.length === 0) {
        resultadosDiv.innerHTML = `
          <div class="p-4 text-amber-800 bg-amber-50 rounded-lg border border-amber-200 text-center">
            No se encontraron certificados asociados al documento <strong>${documento}</strong>.
          </div>
        `;
        return;
      }

      resultadosDiv.innerHTML = certificadosEncontrados
        .map((cert: any) => {
          const titulo = cert.fullName ? `Certificado - ${cert.fullName}` : 'Certificado Tributario';
          const anioText = cert.taxYear ? `Año Fiscal: ${cert.taxYear}` : '';
          
          // Verificamos si existe la ruta del archivo; si no, dejamos una cadena vacía
          // (Ajusta 'pdfFile' al nombre exacto que te devuelva tu API)
          const pdfPath = cert.pdfFile ? cert.pdfFile : '';
          
          // Construimos la URL completa apuntando al CMS local (puerto 4321)
          const pdfUrl = pdfPath ? `http://localhost:4321/media/${pdfPath}` : '';

          // Si no hay archivo PDF asociado, mostramos una advertencia en lugar del botón de ver
          const botonAccion = pdfUrl ? `
            <a 
              href="${pdfUrl}" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="px-4 py-2 bg-green-600 hover:bg-blue-700 text-white text-sm font-medium rounded-md transition-colors flex items-center gap-2 self-end sm:self-auto"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
                <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/>
              </svg>
              Ver Certificado
            </a>
          ` : `
            <span class="text-xs text-amber-600 font-medium bg-amber-50 px-3 py-1 rounded">PDF no disponible temporalmente</span>
          `;

          return `
            <div class="p-5 border border-gray-200 rounded-lg shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white hover:border-gray-300 transition-colors">
              <div>
                <h3 class="font-semibold text-gray-800 uppercase text-sm">${titulo}</h3>
                <p class="text-xs text-gray-500">${cert.description || anioText}</p>
                <span class="text-xs text-gray-400">Documento: ${documento}</span>
              </div>
              ${botonAccion}
            </div>
          `;
        })
        .join('');

    } catch (error) {
      console.error('Error detallado en la consulta:', error);
      if (resultadosDiv) {
        resultadosDiv.innerHTML = `
          <div class="p-4 text-red-800 bg-red-50 rounded-lg border border-red-200 text-center">
            Ocurrió un error al procesar la búsqueda. Por favor intenta de nuevo más tarde.
          </div>
        `;
      }
    } finally {
      loadingDiv?.classList.add('hidden');
      if (btnBuscar) btnBuscar.disabled = false;
    }
  });
</script>