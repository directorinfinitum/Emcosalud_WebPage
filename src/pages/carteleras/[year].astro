---
import AtencionUsuarioHero from '@/components/sections/AtencionUsuarioHero.astro';
import CarteleraEditions from '@/components/sections/CarteleraEditions.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const EMCOSALUD_PORTAL_ID = 1;

// 1. Obtenemos dinámicamente los años disponibles desde la API al compilar
export async function getStaticPaths() {
  try {
    const response = await fetch(`http://localhost:4321/api/capacitaciones.json?portalId=1`);
    if (!response.ok) return [{ params: { year: '2026' } }];

    const json = await response.json();
    const publications = json.data ?? [];
    
    const yearsSet = new Set<string>();
    publications.forEach((pub: { publishedDate?: string }) => {
      if (pub.publishedDate) {
        const pubYear = new Date(pub.publishedDate).getFullYear().toString();
        yearsSet.add(pubYear);
      }
    });

    if (yearsSet.size === 0) {
      yearsSet.add('2026');
    }

    return Array.from(yearsSet).map((year) => ({
      params: { year },
    }));
  } catch (error) {
    console.error('Error al obtener los años para las carteleras:', error);
    return [{ params: { year: '2026' } }];
  }
}

// 2. Extraemos el año actual de la URL
const { year } = Astro.params;
const currentYear = year || '2026';
---

<BaseLayout title={`Cartelera ${currentYear}`} description={`Carteleras informativas ${currentYear} — EMCOSALUD.`}>
  <!-- Overlay del Spinner -->
  <div 
    id="page-loading-overlay" 
    class="fixed inset-0 z-[9999] flex flex-col items-center justify-center bg-white/90 backdrop-blur-sm transition-opacity duration-300"
  >
    <div class="flex flex-col items-center gap-3">
      <svg class="h-10 w-10 animate-spin text-brand-blue" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span class="text-sm font-semibold text-brand-blue">Cargando Cartelera {currentYear}...</span>
    </div>
  </div>

  <AtencionUsuarioHero title={`Cartelera ${currentYear}`} lead="Consulta y descarga las carteleras informativas." />
  
  {/* Pasamos el año dinámico al componente que hace el fetch y filtrado */}
  <CarteleraEditions year={currentYear} />
</BaseLayout>

<script is:inline>
  const overlay = document.getElementById('page-loading-overlay');

  function hideSpinner() {
    if (overlay) {
      overlay.classList.add('opacity-0', 'pointer-events-none');
      setTimeout(() => {
        overlay.style.display = 'none';
      }, 300);
    }
  }

  function showSpinner() {
    if (overlay) {
      overlay.style.display = 'flex';
      overlay.classList.remove('opacity-0', 'pointer-events-none');
    }
  }

  window.addEventListener('cartelera-loaded', hideSpinner);

  const fallbackTimer = setTimeout(hideSpinner, 4000);

  if (document.readyState === 'complete') {
    setTimeout(hideSpinner, 500);
  } else {
    window.addEventListener('load', () => {
      setTimeout(hideSpinner, 500);
    });
  }

  document.addEventListener('click', (e) => {
    const link = e.target.closest('a');
    if (link) {
      const href = link.getAttribute('href');
      const target = link.getAttribute('target');
      if (href && !href.startsWith('#') && target !== '_blank') {
        showSpinner();
      }
    }
  });
</script>